# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Postgres — use the "Session pooler" connection string
# (Supabase dashboard > Connect > Session pooler). Port 5432.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=

# Supabase Storage (S3 protocol): Storage > Settings > S3 Connection. Create a PUBLIC bucket named "media".
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=eu-west-2
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email confirmations (resend.com). Verify the sending domain first.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@your-domain.org
LOGISTICS_NOTIFY_EMAIL=logistics@your-domain.org

# Spam protection (Cloudflare Turnstile). Leave blank in development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_ID=
