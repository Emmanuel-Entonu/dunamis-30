# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Postgres: the "Transaction pooler" connection string, port 6543, which suits Vercel's
# serverless functions. URL-encode any symbols in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=

# Supabase project keys (Project Settings > API). The service role key is a full-access secret:
# never prefix it with NEXT_PUBLIC_ and never commit it.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Photos, stored in a PRIVATE Supabase bucket named "media". Sign in with the project keys:
# access key = the project ref, secret = the anon key, session token = the service role key.
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=<region>
S3_BUCKET=media
S3_ACCESS_KEY_ID=<project-ref>
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=

# Email confirmations (resend.com). Verify the sending domain first.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@your-domain.org
LOGISTICS_NOTIFY_EMAIL=logistics@your-domain.org
TESTIMONY_NOTIFY_EMAIL=communications@your-domain.org

# Spam protection (Cloudflare Turnstile). Set both keys together, or leave both blank.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_ID=
